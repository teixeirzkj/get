{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "{public/config.js,arquivos/**}",
      "maxDuration": 30
    }
  },
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
