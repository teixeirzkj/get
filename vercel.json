{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{public/config.js,arquivos/**}",
      "maxDuration": 30
    }
  },
  "outputDirectory": "public"
}
